# =============================================================================
# FinXUI Core Banking Workbench - Canonical Environment Configuration Template
# Copy this file to `.env.local` for local development overrides.
# =============================================================================

# Authentication Mode (grpc | static)
USER_SOURCE=grpc

# -----------------------------------------------------------------------------
# CLIENT CONFIGURATION (Exposed to Browser Bundle via NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# Application Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# User Session Timeout Limit (in minutes)
NEXT_PUBLIC_LOGOUT_TIME=10

# Default Central Bank Branch Code
NEXT_PUBLIC_CENTRAL_BRANCH=JB9999

# Default Microservice Envelope Route Path
NEXT_PUBLIC_DEFAULT_SERVICE_PATH=default

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION (Private / Node.js Runtime Only)
# -----------------------------------------------------------------------------

# Application Execution Environment
# Options: development | production | test
NODE_ENV=development

# -----------------------------------------------------------------------------
# CORE BANKING gRPC & MICROSERVICE ENDPOINTS (100% Env Driven)
# -----------------------------------------------------------------------------

# Field Definition / GMC Schema Data Source
# Options: grpc | static
MODEL_SOURCE=grpc

# Core Banking gRPC Server Primary Endpoint
GRPC_ADDRESS=localhost:9090

# Microservice Target Mappings
GRPC_ADDRESS_DEFAULTDEV=172.18.18.66:50055
GRPC_ADDRESS_DEFAULT=finx-server:50055
SERVICE_URL_CUSTOMER=http://customer:8383
SERVICE_URL_FINXURM=http://finxurm:8282

# Enable gRPC TLS/SSL Encryption
# Options: false | true
GRPC_TLS=false

# gRPC Request Timeout Deadline (in milliseconds)
GRPC_DEADLINE_MS=8000

# Financial Transaction Type Codes (Comma-separated)
GRPC_FINANCIAL_TYPES=AFT,ACT

# Protocol Envelope Control Names
MODEL_REQUEST_TYPE=GMC
MENU_REQUEST_TYPE=MNU
MENU_CONTROL_NAME=MAIN_MENU

# -----------------------------------------------------------------------------
# REDIS & SESSION CACHING SETTINGS
# -----------------------------------------------------------------------------

# Redis Server Connection URI
REDIS_URL=redis://127.0.0.1:6379

# Key Namespace Prefix for Redis Keys
REDIS_KEY_PREFIX=finx

# Master Cache Toggle
# Options: true | false
CACHE_ENABLED=true

# Cache Rate Cooldown (in milliseconds)
CACHE_COOLDOWN_MS=5000

# Model Schema Specification Cache TTL (in seconds)
SPEC_TTL_SECONDS=3600

# Main Menu Definition Cache TTL (in seconds)
MENU_TTL_SECONDS=600

# Internal Cache Invalidation Token
CACHE_INVALIDATE_TOKEN=super-secret-cache-token

# -----------------------------------------------------------------------------
# SECURITY, AUTH & EXTERNAL SERVICE ENDPOINTS
# -----------------------------------------------------------------------------

# JWT & Cookie Signing Secret (Min 16 characters)
SESSION_SECRET=a960b9e379952ddc2699ae9259b9c28597c6a59a199fbf4b7357bd8e978095ac

# Max Consecutive Login Failures before Rate Limit
LOGIN_LIMIT=3

# External Reporting / PDF Service URL
API_BASE_URL=http://localhost:8080
